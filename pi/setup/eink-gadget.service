[Unit]
Description=E-Ink USB Gadget Display Daemon
After=network.target eink-gadget-setup.service
Requires=eink-gadget-setup.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/e-ink-gadget
ExecStart=/usr/bin/python3 -m pi.display_daemon --device /dev/ttyGS0 --baud 921600
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
