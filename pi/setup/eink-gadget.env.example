# Environment overrides for the e-ink-gadget systemd service.
# make install-service installs this file only if it does not already exist.

EINK_SERIAL_DEVICE=/dev/ttyGS0
EINK_BAUD=921600
EINK_GALLERY_DIR=/var/lib/e-ink-gadget/gallery

# Conservative driver defaults; tune on known-good hardware if desired.
EINK_SPI_HZ=4000000
EINK_RESET_SETTLE_MS=20
EINK_BOOSTER_DELAY_MS=200
EINK_BUSY_POLL_MS=5
EINK_BUSY_TIMEOUT_MS=90000
